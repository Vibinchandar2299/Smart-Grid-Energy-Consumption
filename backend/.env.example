PROJECT_NAME="Smart Grid Energy Consumption Statistical Modeling API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# PostgreSQL connection string
# Standard sync connection for SQLAlchemy
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_grid_energy

# Server host & port
HOST=0.0.0.0
PORT=8000

# CORS Origins (JSON formatted list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Path to frozen statistical artifacts (relative to backend or absolute)
ARTIFACTS_DIR="../data/frozen_artifacts"
