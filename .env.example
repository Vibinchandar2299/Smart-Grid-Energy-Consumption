# ==========================================
# Root Environment Configuration Example
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_grid_energy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend URL Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_grid_energy
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frozen Artifacts Directory
ARTIFACTS_DIR=../data/frozen_artifacts

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
